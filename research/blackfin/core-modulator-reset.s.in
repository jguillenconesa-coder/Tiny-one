imm32 P2,0x1aaac0c
P3=17;
LSETUP(in0,in0end) LC0=P3;
in0: R0=[P1++];
in0end: [P2++]=R0;
imm32 P2,0x1aaad60
P3=21;
LSETUP(in1,in1end) LC0=P3;
in1: R0=[P1++];
in1end: [P2++]=R0;
imm32 P2,0x2010000
P3=32;
LSETUP(in2,in2end) LC0=P3;
in2: R0=[P1++];
in2end: [P2++]=R0;
imm32 P2,0x2010080
P3=32;
LSETUP(in3,in3end) LC0=P3;
in3: R0=[P1++];
in3end: [P2++]=R0;
imm32 P2,0x1dd5a88
P3=8;
LSETUP(in4,in4end) LC0=P3;
in4: R0=[P1++];
in4end: [P2++]=R0;
imm32 P2,0xff8014c4
P3=32;
LSETUP(in5,in5end) LC0=P3;
in5: R0=[P1++];
in5end: [P2++]=R0;
imm32 P2,0xff801644
P3=32;
LSETUP(in6,in6end) LC0=P3;
in6: R0=[P1++];
in6end: [P2++]=R0;
imm32 P2,0xff802bc8
P3=2;
LSETUP(in7,in7end) LC0=P3;
in7: R0=[P1++];
in7end: [P2++]=R0;
imm32 P1,0x02010040
imm32 R0,0x02010100
[P1]=R0;
imm32 P1,0x020100c0
imm32 R0,0x02010120
[P1]=R0;
imm32 P1,0x02010100
R0=[P4+20];
W[P1+0x18]=R0;
R0.H=primary_endpoint;
R0.L=primary_endpoint;
[P1+0x1c]=R0;
imm32 P1,0x02010120
R0=[P4+24];
W[P1+0x18]=R0;
R0.H=secondary_endpoint;
R0.L=secondary_endpoint;
[P1+0x1c]=R0;
P1.H=reset_functions;
P1.L=reset_functions;
P0=[P4+12];
P0=P1+(P0<<2);
R0=[P0];
P0.H=primary_reset;
P0.L=primary_reset;
[P0]=R0;
P0=[P4+16];
P0=P1+(P0<<2);
R0=[P0];
P0.H=secondary_reset;
P0.L=secondary_reset;
[P0]=R0;
R0=[P4];
CC=R0==0;
IF CC JUMP synth_setup;
imm32 P1,0x01aaad84
imm32 P2,0x01aaac48
imm32 P3,0x01aaac10
JUMP.S setup;
synth_setup:
imm32 P1,0x01aaad6c
imm32 P2,0x01aaac44
imm32 P3,0x01aaac0c
setup:
P0.H=selector;
P0.L=selector;
[P0]=P3;
R0=[P4+8];
[P3]=R0;
P0=[P4+4];
P1=P1+(P0<<2);
R0=0;
R1=[P4+12];
CC=R1==0;
IF CC JUMP no_primary;
imm32 R0,0x02010040
no_primary: [P1]=R0;
R0=0;
R1=[P4+16];
CC=R1==0;
IF CC JUMP no_secondary;
imm32 R0,0x020100c0
no_secondary: [P2]=R0;
P1.H=trace;
P1.L=trace;
P0=7;
R0=0;
LSETUP(clear_trace,clear_trace_end) LC0=P0;
clear_trace: [P1++]=R0;
clear_trace_end: NOP;
R0=[P4+28];
CC=BITTST(R0,0);
IF !CC JUMP dispatch;
R0=[P4];
CC=R0==0;
IF CC JUMP clear_synth;
imm32 P0,0x01967330
JUMP.S clear_call;
clear_synth:
imm32 P0,0x0196745a
clear_call: CALL(P0);
dispatch:
R0=[P4];
CC=R0==0;
IF CC JUMP synth_dispatch;
imm32 P0,0x0196735e
JUMP.S dispatch_call;
synth_dispatch:
imm32 P0,0x019673dc
dispatch_call:
R0=[P4+4];
CALL(P0);
imm32 P1,0x1aaac0c
P3=17;
LSETUP(out0,out0end) LC0=P3;
out0: R0=[P1++];
out0end: [P5++]=R0;
imm32 P1,0x1aaad60
P3=21;
LSETUP(out1,out1end) LC0=P3;
out1: R0=[P1++];
out1end: [P5++]=R0;
imm32 P1,0x2010000
P3=32;
LSETUP(out2,out2end) LC0=P3;
out2: R0=[P1++];
out2end: [P5++]=R0;
imm32 P1,0x2010080
P3=32;
LSETUP(out3,out3end) LC0=P3;
out3: R0=[P1++];
out3end: [P5++]=R0;
imm32 P1,0x1dd5a88
P3=8;
LSETUP(out4,out4end) LC0=P3;
out4: R0=[P1++];
out4end: [P5++]=R0;
imm32 P1,0xff8014c4
P3=32;
LSETUP(out5,out5end) LC0=P3;
out5: R0=[P1++];
out5end: [P5++]=R0;
imm32 P1,0xff801644
P3=32;
LSETUP(out6,out6end) LC0=P3;
out6: R0=[P1++];
out6end: [P5++]=R0;
imm32 P1,0xff802bc8
P3=2;
LSETUP(out7,out7end) LC0=P3;
out7: R0=[P1++];
out7end: [P5++]=R0;
P1.H=trace;
P1.L=trace;
P3=7;
LSETUP(trace_copy,trace_copy_end) LC0=P3;
trace_copy: R0=[P1++];
trace_copy_end: [P5++]=R0;
imm32 P0,740
P4=P4+P0;
P0.H=inputs_end;
P0.L=inputs_end;
CC=P4==P0;
IF !CC JUMP next_case;
R0.H=io_args;
R0.L=io_args;
P0=5;
EXCPT 0;
exit 0
primary_endpoint:
P0.H=trace;
P0.L=trace;
R2=[P0];
R2+=1;
[P0]=R2;
[P0+4]=R0;
[P0+8]=R1;
P1.H=selector;
P1.L=selector;
P1=[P1];
R2=[P1];
[P0+12]=R2;
R2=[P4+28];
CC=BITTST(R2,1);
IF !CC JUMP primary_tail;
R2=[P4+32];
[P1]=R2;
primary_tail:
P0.H=primary_reset;
P0.L=primary_reset;
P0=[P0];
JUMP(P0);
secondary_endpoint:
P0.H=trace;
P0.L=trace;
R2=[P0];
R2+=1;
[P0]=R2;
[P0+16]=R0;
[P0+20]=R1;
P1.H=selector;
P1.L=selector;
P1=[P1];
R2=[P1];
[P0+24]=R2;
P0.H=secondary_reset;
P0.L=secondary_reset;
P0=[P0];
JUMP(P0);
.data
.align 4
io_args: .long 1,results,@BYTES@
reset_functions: .long 0,0x019cfd5a,0x019cff16,0x019ced74,0x019cef66,0x019cbdca
primary_reset: .long 0
secondary_reset: .long 0
selector: .long 0
trace: .space 28
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
.section .handles,"aw"
.space 0x140
.section .results,"aw",@nobits
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
