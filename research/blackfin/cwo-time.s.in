// SPDX-License-Identifier: AGPL-3.0-only
.include "testutils.inc"
start
imm32 SP,0x03f00000
SP += -24;
P1.H = phase_floats;
P1.L = phase_floats;
imm32 P2,0xff9004b0
P0 = 8;
LSETUP(copy_coeff,copy_coeff_end) LC0 = P0;
copy_coeff: R0 = [P1++];
copy_coeff_end: [P2++] = R0;
// Original initializer with four explicit substitutions, not decrypted bytes.
imm32 P0,0x01946228
CALL (P0);
imm32 P0,0x019463b0
CALL (P0);
// Independent table producer, consuming legible SDRAM constants.
imm32 P0,0x01945da8
CALL (P0);
R0.H = table_args;
R0.L = table_args;
P0 = 5;
EXCPT 0;
P4.H = inputs;
P4.L = inputs;
P5.H = results;
P5.L = results;
next_case:
P1 = 24;
P1 = P4 + P1;
R0 = [P1];
CC = R0 == 0;
IF CC JUMP run_delay;
P1 = P4;
P2.H = delay_state;
P2.L = delay_state;
P0 = 3;
LSETUP(load_state,load_state_end) LC0 = P0;
load_state: R0 = [P1++];
load_state_end: [P2++] = R0;
P1 = 28;
P1 = P4 + P1;
R0 = [P1];
imm32 R1,1664525
imm32 R2,1013904223
imm32 P1,0x03600000
imm32 P0,32768
LSETUP(seed,seed_end) LC0 = P0;
seed: R0 *= R1;
R0 = R0 + R2;
seed_end: [P1++] = R0;
run_delay:
imm32 P1,0x01ab8b94
imm32 R0,0x03600000
[P1] = R0;
R0.H = delay_state;
R0.L = delay_state;
R1 = P4;
R1 += 12;
R2 = [P4 + 16];
R3 = [P4 + 20];
[SP + 12] = R3;
P0 = P5;
P0 += 12;
[SP + 16] = P0;
R3 = 0;
[SP + 20] = R3;
imm32 P0,0x01943744
CALL (P0);
P1.H = delay_state;
P1.L = delay_state;
P0 = 3;
LSETUP(save_delay,save_delay_end) LC0 = P0;
save_delay: R0 = [P1++];
save_delay_end: [P5++] = R0;
R0 = 0;
W[P5 + 2] = R0;
P5 += 4;
// R0 is unused; phase and increment pointers are in R1/R2.
R1 = P4;
R1 += 32;
R2 = P4;
R2 += 36;
P0 = P4;
P0 += 40;
[SP + 12] = P0;
[SP + 16] = P5;
P0 = 128;
P0 = P5 + P0;
[SP + 20] = P0;
imm32 P0,0x019446e0
CALL (P0);
P0 = 256;
P5 = P5 + P0;
P0.H = calls;
P0.L = calls;
R0 = [P0];
R0 += 1;
[P0] = R0;
R1 = 511;
R1 = R0 & R1;
CC = R1 == 0;
IF !CC JUMP no_snapshot;
imm32 P1,0x03600000
imm32 P0,32768
LSETUP(save_memory,save_memory_end) LC0 = P0;
save_memory: R0 = [P1++];
save_memory_end: [P5++] = R0;
no_snapshot:
P0 = 44;
P4 = P4 + P0;
P0.H = inputs_end;
P0.L = inputs_end;
CC = P4 == P0;
IF !CC JUMP next_case;
R0.H = output_args;
R0.L = output_args;
P0 = 5;
EXCPT 0;
exit 0
.data
.align 4
table_args: .long 1,0x01ba4e14,22684
output_args: .long 1,results,@BYTES@
calls: .long 0
delay_state: .space 12
phase_floats: .incbin "@WORK@/phase-floats.bin"
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
.section .results,"aw",@nobits
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
