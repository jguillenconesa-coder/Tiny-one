imm32 P2,33690624
imm32 P3,40
LSETUP(load9,endload9) LC0=P3;
load9: R0=[P1++];
endload9: [P2++]=R0;
imm32 P2,33690880
imm32 P3,40
LSETUP(load10,endload10) LC0=P3;
load10: R0=[P1++];
endload10: [P2++]=R0;
imm32 P2,33691136
imm32 P3,68
LSETUP(load11,endload11) LC0=P3;
load11: R0=[P1++];
endload11: [P2++]=R0;
imm32 R0,0x5a5a5a5a
P1.H=returned;
P1.L=returned;
[P1]=R0;
R0=[P4];
CC=R0==1;
IF CC JUMP direct_pump;
CC=R0==2;
IF CC JUMP completion;
R3=4;
CC=R0==R3;
IF CC JUMP completion;
R0=0;
imm32 R1,0x02021608
R2=[P4+4];
imm32 P0,0x019e0d18
CALL(P0);
R0=[P4];
CC=R0==3;
IF CC JUMP completion;
JUMP.L saved;
direct_pump:
R0=0;
imm32 R1,0x02021608
R2=[P4+4];
imm32 P0,0x01a6a5fc
CALL(P0);
P1.H=returned;
P1.L=returned;
[P1]=R0;
JUMP.L saved;
completion:
SP+=-24;
R0=[P4+12];
[SP+12]=R0;
R0=[P4+16];
[SP+16]=R0;
R0=[P4];
R3=4;
CC=R0==R3;
R1=9;
R2=16;
IF CC R1=R2;
R0=0;
R2=[P4+8];
imm32 P0,0x019e10fc
CALL(P0);
SP+=24;
saved:
imm32 P1,27990840
imm32 P3,1030
LSETUP(save0,endsave0) LC0=P3;
save0: R0=[P1++];
endsave0: [P5++]=R0;
imm32 P1,31449144
imm32 P3,3
LSETUP(save1,endsave1) LC0=P3;
save1: R0=[P1++];
endsave1: [P5++]=R0;
