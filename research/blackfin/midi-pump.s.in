// Original enqueue, completion/reset callback and pump, busy supplied endpoint.
.include "testutils.inc"
start
imm32 SP,0x07f00000
P4.H=inputs;
P4.L=inputs;
P5.H=results;
P5.L=results;
next_case:
P1=P4;
P1+=20;
imm32 P2,27990840
imm32 P3,1030
LSETUP(load0,endload0) LC0=P3;
load0: R0=[P1++];
endload0: [P2++]=R0;
imm32 P2,31449144
imm32 P3,3
LSETUP(load1,endload1) LC0=P3;
load1: R0=[P1++];
endload1: [P2++]=R0;
