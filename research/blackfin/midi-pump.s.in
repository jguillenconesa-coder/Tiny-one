imm32 P3,12
LSETUP(save7,endsave7) LC0=P3;
save7: R0=[P1++];
endsave7: [P5++]=R0;
imm32 P1,33690368
imm32 P3,8
LSETUP(save8,endsave8) LC0=P3;
save8: R0=[P1++];
endsave8: [P5++]=R0;
imm32 P1,33690624
imm32 P3,40
LSETUP(save9,endsave9) LC0=P3;
save9: R0=[P1++];
endsave9: [P5++]=R0;
imm32 P1,33690880
imm32 P3,40
LSETUP(save10,endsave10) LC0=P3;
save10: R0=[P1++];
endsave10: [P5++]=R0;
imm32 P1,33691136
imm32 P3,68
LSETUP(save11,endsave11) LC0=P3;
save11: R0=[P1++];
endsave11: [P5++]=R0;
P1.H=returned;
P1.L=returned;
R0=[P1];
[P5++]=R0;
imm32 P0,5108
P4=P4+P0;
P0.H=inputs_end;
P0.L=inputs_end;
CC=P4==P0;
IF CC JUMP done;
JUMP.L next_case;
done:
R0.H=io_args;
R0.L=io_args;
P0=5;
EXCPT 0;
exit 0
.data
.align 4
returned: .space 4
io_args: .long 1,results,@BYTES@
.section .inputs,"a"
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
.section .results,"aw",@nobits
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
