// SPDX-License-Identifier: AGPL-3.0-only
.include "testutils.inc"
start
imm32 SP, 0x03000000
@SETUP@
P0.H = inputs;
P0.L = inputs;
P1.H = input_ptr;
P1.L = input_ptr;
[P1] = P0;
P0.H = results;
P0.L = results;
P1.H = result_ptr;
P1.L = result_ptr;
[P1] = P0;
probe_loop:
P0.H = input_ptr;
P0.L = input_ptr;
P1 = [P0];
P4 = 84;
P4 = P1 + P4;
R0 = [P4];
R0 = R0.B (Z);
CC = R0 == 0;
IF CC JUMP copy_targets;
P2.H = state;
P2.L = state;
P3 = 11;
LSETUP(copy_state,copy_state_end) LC0 = P3;
copy_state:
R0 = [P1++];
copy_state_end: [P2++] = R0;
R0 = [P1++];
imm32 P2, 0xff802bc8
[P2] = R0;
R0 = [P1++];
imm32 P2, 0x01dd5c6c
[P2] = R0;
copy_targets:
P0.H = input_ptr;
P0.L = input_ptr;
P1 = [P0];
P4 = 68;
P1 = P1 + P4;
imm32 P2, 0xff801724
P3 = 4;
LSETUP(copy_target,copy_target_end) LC0 = P3;
copy_target:
R0 = [P1++];
copy_target_end: [P2++] = R0;
R0 = [P1];
R1 = R0 >> 16;
imm32 P2, 0xff8016e4
[P2] = R1;
imm32 P2, 0xff801704
[P2] = R1;
imm32 P2, 0xff8016d4
R1 = 0;
[P2] = R1;
imm32 P2, 0xff8016d8
[P2] = R1;
R0 = R0.B (Z);
CC = R0 == 2;
IF !CC JUMP process;
R0.H = state;
R0.L = state;
P0.H = input_ptr;
P0.L = input_ptr;
R1 = [P0];
R1 += 52;
imm32 P0, 0x019ced74
CALL (P0);
process:
R0.H = state;
R0.L = state;
P0.H = input_ptr;
P0.L = input_ptr;
P1 = [P0];
R1 = P1;
R1 += 52;
P4 = 84;
P1 = P1 + P4;
R2 = [P1];
R2 >>= 8;
R2 = R2.B (Z);
imm32 P0, 0x019cea70
CALL (P0);
P0.H = result_ptr;
P0.L = result_ptr;
P2 = [P0];
P4 = 68;
P4 = P2 + P4;
[P4] = R0;
P1.H = state;
P1.L = state;
P3 = 11;
LSETUP(save_state,save_state_end) LC0 = P3;
save_state:
R0 = [P1++];
save_state_end: [P2++] = R0;
imm32 P1, 0xff802bc8
R0 = [P1];
[P2++] = R0;
imm32 P1, 0x01dd5c6c
R0 = [P1];
[P2++] = R0;
imm32 P1, 0xff801724
P3 = 4;
LSETUP(save_target,save_target_end) LC0 = P3;
save_target:
R0 = [P1++];
save_target_end: [P2++] = R0;
P2 += 4;
[P0] = P2;
P0.H = input_ptr;
P0.L = input_ptr;
R0 = [P0];
R1 = 88;
R0 = R0 + R1;
[P0] = R0;
R1.H = inputs_end;
R1.L = inputs_end;
CC = R0 == R1;
IF !CC JUMP probe_loop;
R0.H = io_args;
R0.L = io_args;
P0 = 5;
EXCPT 0;
exit 0
.data
.align 4
io_args: .long 1,results,@BYTES@
input_ptr: .long 0
result_ptr: .long 0
state: .space 44
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
