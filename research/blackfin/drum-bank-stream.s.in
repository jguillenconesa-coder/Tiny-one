.include "testutils.inc"
start
imm32 SP,0x07f00000
@SETUP@
// Eight explicit sample references, each a pointer to its PCM-pointer word.
imm32 P1,0x01cc10cc
imm32 R0,0x02010000
R1 = 8;
P0 = 8;
LSETUP(refs,refs_end) LC0=P0;
refs: [P1++] = R0;
refs_end: R0=R0+R1;
P1.H=initial_controls;
P1.L=initial_controls;
imm32 P2,0x01aaadb4
P0=768;
LSETUP(init_controls,init_controls_end) LC0=P0;
init_controls: R0=[P1++];
init_controls_end: [P2++]=R0;
imm32 P1,0x01aaac48
R0=0;
[P1]=R0;
imm32 P1,0x01aaad84
P0=12;
LSETUP(clear_mod,clear_mod_end) LC0=P0;
clear_mod: [P1++]=R0;
clear_mod_end: NOP;
imm32 P1,0xff801b50
imm32 R0,0x6c6c6c6c
P0=128;
LSETUP(init_derived,init_derived_end) LC0=P0;
init_derived: [P1++]=R0;
init_derived_end: NOP;
P4.H=inputs;
P4.L=inputs;
P5.H=results;
P5.L=results;
next_case:
R0=[P4];
CC=BITTST(R0,0);
IF !CC JUMP reset_done;
imm32 P1,0x01dfe730
imm32 R0,0xa5a5a500
[P1]=R0;
imm32 P1,0x01dfe03c
R0=0;
[P1]=R0;
imm32 P1,0x01aafd60
imm32 R0,0x7f7f7f7f
P0=32;
LSETUP(init_external,init_external_end) LC0=P0;
init_external: [P1++]=R0;
init_external_end: NOP;
imm32 P1,0xff801038
R0=0;
P0=203;
LSETUP(clear_globals,clear_globals_end) LC0=P0;
clear_globals: [P1++]=R0;
clear_globals_end: NOP;
imm32 P1,0x01dfe734
imm32 R0,0x5a5a5a5a
P0=641;
LSETUP(clear_list,clear_list_end) LC0=P0;
clear_list: [P1++]=R0;
clear_list_end: NOP;
imm32 P1,0x01dff134
R0=0;
[P1]=R0;
imm32 P1,0xff801038
R0=1;
[P1]=R0;
R0=[P4+8];
imm32 P1,0x01aaac10
[P1]=R0;
R0=8;
imm32 P0,0x01967984
CALL(P0);
reset_done:
R0=[P4+4];
imm32 P1,0x01aaac10
[P1]=R0;
R0=[P4+20];
imm32 P1,0x018c2180
[P1]=R0;
R0=[P4];
CC=BITTST(R0,1);
IF !CC JUMP loaded;
P1=P4;
P1+=40;
imm32 P2,0xffb00000
P0=60;
LSETUP(load_pool,load_pool_end) LC0=P0;
load_pool: R0=[P1++];
load_pool_end: [P2++]=R0;
imm32 P2,0xff801070
P0=3;
LSETUP(load_busy,load_busy_end) LC0=P0;
load_busy: R0=[P1++];
load_busy_end: [P2++]=R0;
imm32 P2,0xff8010f4
P0=12;
LSETUP(load_owner,load_owner_end) LC0=P0;
load_owner: R0=[P1++];
load_owner_end: [P2++]=R0;
imm32 P2,0xff801334
P0=12;
LSETUP(load_pads,load_pads_end) LC0=P0;
load_pads: R0=[P1++];
load_pads_end: [P2++]=R0;
loaded:
R0=[P4];
CC=BITTST(R0,8);
IF !CC JUMP begin_done;
imm32 P0,0x01a85df8
CALL(P0);
begin_done:
R0=[P4];
CC=BITTST(R0,9);
IF !CC JUMP finish_done;
R0=8;
imm32 P0,0x01a85e40
CALL(P0);
finish_done:
R0=[P4];
CC=BITTST(R0,6);
IF !CC JUMP retrigger_done;
imm32 P0,0x01a856bc
CALL(P0);
retrigger_done:
R0=[P4];
CC=BITTST(R0,7);
IF !CC JUMP clear_done;
imm32 P0,0x01a8624c
CALL(P0);
clear_done:
R0=[P4];
CC=BITTST(R0,2);
IF !CC JUMP on_done;
R0=P4;
R0+=24;
R1=[P4+16];
imm32 P0,0x01a84ba0
CALL(P0);
on_done:
R0=[P4];
CC=BITTST(R0,3);
IF !CC JUMP off_done;
R0=P4;
R0+=24;
imm32 P0,0x01a84dac
CALL(P0);
off_done:
imm32 R0,0x13579bdf
P1.H=query;
P1.L=query;
[P1]=R0;
R0=[P4];
CC=BITTST(R0,5);
IF !CC JUMP queried;
R0=[P4+12];
imm32 P0,0x01967308
CALL(P0);
P1.H=query;
P1.L=query;
[P1]=R0;
queried:
imm32 R0,0x2468ace0
P1.H=busy_query;
P1.L=busy_query;
[P1]=R0;
R0=[P4];
CC=BITTST(R0,10);
IF !CC JUMP busy_queried;
imm32 P0,0x01a27e2c
CALL(P0);
P1.H=busy_query;
P1.L=busy_query;
[P1]=R0;
busy_queried:
// Preserve the supplied controls/pitch/gain while rendering an original block.
P1=P4;
imm32 P0,388
P1=P1+P0;
imm32 P2,0xff801950
P0=128;
LSETUP(load_pitch,load_pitch_end) LC0=P0;
load_pitch: R0=[P1++];
load_pitch_end: [P2++]=R0;
imm32 P2,0xff801d50
P0=64;
LSETUP(load_gain,load_gain_end) LC0=P0;
load_gain: R0=[P1++];
load_gain_end: [P2++]=R0;
R0=[P4+12];
imm32 P1,0xff801334
P0=R0;
P1=P1+(P0<<2);
R0=[P1];
R0<<=4;
R1=[P4+4];
R2=384;
R1*=R2;
R0=R0+R1;
imm32 R1,0x01aaadb4
R0=R0+R1;
P3=R0;
// Poison output so skipped renders are checked too.
P1.H=audio;
P1.L=audio;
imm32 R0,0x24681357
P0=64;
LSETUP(init_audio,init_audio_end) LC0=P0;
init_audio: [P1++]=R0;
init_audio_end: NOP;
R0=[P4];
CC=BITTST(R0,4);
IF !CC JUMP rendered;
R0=[P4+12];
R1=20;
R0*=R1;
imm32 R1,0xffb00000
R0=R0+R1;
R1.H=audio;
R1.L=audio;
R2=P3;
imm32 P0,0x019789ec
CALL(P0);
rendered:
P1.H=query;
P1.L=query;
R0=[P1];
[P5++]=R0;
imm32 P1,0xffb00000
P0=60;
LSETUP(save_pool,save_pool_end) LC0=P0;
save_pool: R0=[P1++];
save_pool_end: [P5++]=R0;
imm32 P1,0xff801038
P0=203;
LSETUP(save_globals,save_globals_end) LC0=P0;
save_globals: R0=[P1++];
save_globals_end: [P5++]=R0;
imm32 P1,0x01dfe734
imm32 R0,0x5a5a5a5a
P0=641;
LSETUP(save_list,save_list_end) LC0=P0;
save_list: R0=[P1++];
save_list_end: [P5++]=R0;
P1.H=audio;
P1.L=audio;
P0=64;
LSETUP(save_audio,save_audio_end) LC0=P0;
save_audio: R0=[P1++];
save_audio_end: [P5++]=R0;
imm32 P1,0xff801950
P0=128;
LSETUP(save_pitch,save_pitch_end) LC0=P0;
save_pitch: R0=[P1++];
save_pitch_end: [P5++]=R0;
imm32 P1,0xff801d50
P0=64;
LSETUP(save_gain,save_gain_end) LC0=P0;
save_gain: R0=[P1++];
save_gain_end: [P5++]=R0;
imm32 P1,0xff801b50
P0=128;
LSETUP(save_derived,save_derived_end) LC0=P0;
save_derived: R0=[P1++];
save_derived_end: [P5++]=R0;
imm32 P1,0x01dfe730
R0=[P1];
[P5++]=R0;
P1.H=busy_query;
P1.L=busy_query;
R0=[P1];
[P5++]=R0;
imm32 P1,0x01aafd60
P0=32;
LSETUP(save_external,save_external_end) LC0=P0;
save_external: R0=[P1++];
save_external_end: [P5++]=R0;
imm32 P0,1156
P4=P4+P0;
P0.H=inputs_end;
P0.L=inputs_end;
CC=P4==P0;
IF !CC JUMP next_case;
R0.H=io_args;
R0.L=io_args;
P0=5;
EXCPT 0;
R0.H=pcm_args;
R0.L=pcm_args;
P0=5;
EXCPT 0;
exit 0
.data
.align 4
query: .space 4
busy_query: .space 4
audio: .space 256
coeff_args: .long 1,0xff802154,2052
io_args: .long 1,results,@BYTES@
pcm_args: .long 1,samples,16896
@HANDLES@
samples: .incbin "@WORK@/inputs.bin",0,16896
initial_controls: .incbin "@WORK@/inputs.bin",16896,3072
inputs: .incbin "@WORK@/inputs.bin",19968
inputs_end:
.section .results,"aw",@nobits
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
