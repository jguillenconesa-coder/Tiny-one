.include "testutils.inc"
start
imm32 SP,0x03000000
P4.H = inputs;
P4.L = inputs;
P5.H = results;
P5.L = results;
next_case:
P0 = 304;
P0 = P4 + P0;
R0 = [P0];
CC = R0 == 0;
IF !CC JUMP audio_copy;
P1 = P4;
P2.H = state;
P2.L = state;
P0 = 26;
LSETUP(copy_state,copy_state_end) LC0 = P0;
copy_state: R0 = [P1++];
copy_state_end: [P2++] = R0;
// Explicit deterministic contents in both slots; no allocator is called.
P0 = 308;
P0 = P4 + P0;
R0 = [P0];
imm32 P1,0x01001ea8
imm32 R1,1664525
imm32 R2,1013904223
imm32 P0,29136
LSETUP(seed_start,seed_end) LC0 = P0;
seed_start: R0 *= R1;
R0 = R0 + R2;
seed_end: [P1++] = R0;
imm32 P1,0x018b6488
imm32 R0,0x12345678
[P1++] = R0;
imm32 R0,0x23456789
[P1] = R0;
P0 = 240;
P1 = P4 + P0;
imm32 P2,0xff801774
P0 = 16;
LSETUP(copy_display,copy_display_end) LC0 = P0;
copy_display: R0 = [P1++];
copy_display_end: [P2++] = R0;
R0.H = state;
R0.L = state;
P0 = 312;
P0 = P4 + P0;
R1 = [P0];
imm32 P0,0x01a32e9a
CALL (P0);
audio_copy:
P0 = 112;
P1 = P4 + P0;
P2.H = audio;
P2.L = audio;
P0 = 32;
LSETUP(copy_audio,copy_audio_end) LC0 = P0;
copy_audio: R0 = [P1++];
copy_audio_end: [P2++] = R0;
P0 = 304;
P0 = P4 + P0;
R0 = [P0];
CC = R0 == 0;
IF CC JUMP save;
R0.H = state;
R0.L = state;
R1.H = audio;
R1.L = audio;
R2 = P4;
R3 = 104;
R2 = R2 + R3;
imm32 P0,0x01a326e8
CALL (P0);
save:
P1.H = state;
P1.L = state;
P0 = 26;
LSETUP(save_state,save_state_end) LC0 = P0;
save_state: R0 = [P1++];
save_state_end: [P5++] = R0;
P1.H = audio;
P1.L = audio;
P0 = 32;
LSETUP(save_audio,save_audio_end) LC0 = P0;
save_audio: R0 = [P1++];
save_audio_end: [P5++] = R0;
imm32 P1,0xff801774
P0 = 16;
LSETUP(save_display,save_display_end) LC0 = P0;
save_display: R0 = [P1++];
save_display_end: [P5++] = R0;
imm32 P1,0x018b6488
R0 = [P1++];
[P5++] = R0;
R0 = [P1];
[P5++] = R0;
imm32 P1,0x01001ea8
imm32 P0,29136
LSETUP(save_memory,save_memory_end) LC0 = P0;
save_memory: R0 = [P1++];
save_memory_end: [P5++] = R0;
P0 = 316;
P4 = P4 + P0;
P0.H = inputs_end;
P0.L = inputs_end;
CC = P4 == P0;
IF !CC JUMP next_case;
R0.H = output_args;
R0.L = output_args;
P0 = 5;
EXCPT 0;
exit 0
.data
.align 4
output_args: .long 1,results,@BYTES@
state: .space 104
audio: .space 128
inputs: .incbin "@WORK@/inputs.bin"
inputs_end:
results: .space @BYTES@
.section .sdram,"awx"
.incbin "@WORK@/sdram.bin"
